{
  "name": "technion-course-tree",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test --experimental-test-isolation=none --test-reporter spec tests/*.test.ts scripts/course-data.test.mjs",
    "data:update": "node scripts/update-data.mjs --discover --refresh",
    "data:rebuild": "node scripts/update-data.mjs --offline",
    "data:test": "node scripts/course-data.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@fontsource/heebo": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@xyflow/react": "^12.9.3",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/dagre": "^0.7.53",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
